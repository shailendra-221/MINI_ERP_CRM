# PostgreSQL connection string
# Local example:  postgresql://postgres:postgres@localhost:5432/mini_erp_crm
# Neon/Supabase/Render example: postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp_crm"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
NODE_ENV=development

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173"
